# Copie este arquivo para .env e preencha.

# Banco PostgreSQL (Neon): connection string do painel do Neon.
DATABASE_URL=postgresql://<usuario>:<senha>@<host>/<banco>?sslmode=require

# NextAuth: gere com `openssl rand -base64 32`. Obrigatório em produção.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Usados apenas por `npm run db:seed` para criar o administrador.
# Não existe senha padrão: o seed falha se estes valores faltarem.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
